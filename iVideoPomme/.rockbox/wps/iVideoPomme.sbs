%Vl(battery,260,6,26,12,3)%Vf(000000)%Vb(FFFFFF)
%ac%bl%%
%Vl(b,36,5,10,13,-)%Vf(000000)%Vb(FFFFFF)
%?mh<%xd(C)|%?mr<%xd(C)>>
%Vi(-,0,24,320,216,1)%Vf(000000)%Vb(FFFFFF)
