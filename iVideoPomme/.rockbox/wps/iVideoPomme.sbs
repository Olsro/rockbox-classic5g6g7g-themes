%T(0,0,50,24,select)
%T(0,0,50,24,&cancel)
%T(60,0,200,24,menu)
%T(60,0,200,24,&cancel)
%wd
%Fl(2,19-PodiumCJK18-a4.fnt)
%Fl(3,10-Pixo7B.fnt)
%xl(A,Battery Icon.bmp,0,0,25)
%xl(B,Disk Access.bmp,0,0,6)
%xl(C,Hold Icon.bmp,0,0)
%xl(D,Playmode Icon.bmp,0,0,4)
# Screens 2-5 have dedicated titles; menus and browsers use Rockbox's list title.
# The final conditional branch also handles screen IDs above 6 (files are 7).
%?St(battery display)<%?cs<%Vd(t)|%Vd(n)|%Vd(n)|%Vd(n)|%Vd(n)|%Vd(t)>|%?cs<%Vd(tbat)|%Vd(nbat)|%Vd(nbat)|%Vd(nbat)|%Vd(nbat)|%Vd(tbat)>%Vd(battery)>
%Vl(n,53,4,214,19,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?cs<||%?Rp<%Sx(Recording)>|%?tp<%Sx(FM Radio)>|%?if(%cs, =, 5)<%Sx(Playlist)>>
%Vl(t,53,4,214,19,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?Lt<%Lt|%?if(%cs, =, 7)<%Sx(Files)|iPod>>
%Vl(nbat,60,4,200,19,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?cs<||%?Rp<%Sx(Recording)>|%?tp<%Sx(FM Radio)>|%?if(%cs, =, 5)<%Sx(Playlist)>>
%Vl(tbat,60,4,200,19,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?Lt<%Lt|%?if(%cs, =, 7)<%Sx(Files)|iPod>>
