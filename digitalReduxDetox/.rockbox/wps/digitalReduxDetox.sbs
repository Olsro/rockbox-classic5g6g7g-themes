# Improved by OlsroFR (2025)
#### SBS FILE ########################

############ Status Bar ##############
## Disable Status Bar
%wd

%xl(F,disk.bmp,0,0,6)
%xl(L,loading.bmp,0,0,16)

#-- Title Bar Disabler
#%?Lt<|>

#Status Bar Background
%V(0,0,-,16,-)%Vb(-)

%Fl(3,19-MPLUSRounded1c-Medium.fnt)
%Fl(4,20-MPLUSRounded1c-Medium.fnt)
%Fl(5,17-MPLUSRounded1c-Medium.fnt)
%Fl(6,18-MPLUSRounded1c-Medium.fnt)

## Playback Mode
%xl(B,status_mode.bmp,0,0,4)
%V(5,3,14,12,0)%Vb(-)%Vf(-)
%al%?mp<|%xd(Ba)|%xd(Bb)|%xd(Bc)|%xd(Bd)>

## Menu Info
%V(25,0,160,17,6)%Vb(C7D8D9)%Vf(000000)
 %s%Lt

#-- Disk working
%V(190,4,11,11,-)
%?lh<%t(0.1)%xd(La);%t(0.1)%xd(Lb);%t(0.1)%xd(Lc);%t(0.1)%xd(Ld);%t(0.1)%xd(Le);%t(0.1)%xd(Lf);%t(0.1)%xd(Lg);%t(0.1)%xd(Lh);%t(0.1)%xd(Li);%t(0.1)%xd(Lj);%t(0.1)%xd(Lk);%t(0.1)%xd(Ll);%t(0.1)%xd(Lm);%t(0.1)%xd(Ln);%t(0.1)%xd(Lo);%t(0.1)%xd(Lp)|>

## Battery Text
%V(204,1,40,20,6)%Vb(-)%Vf(-)
%ar%bl%%

## Battery Icon
%xl(H,battery_level.bmp,0,0,12)
%V(248,3,37,14,0)%Vb(-)%Vf(-)
%?bp<%?bc<%xd(Hl)|%xd(Hl)>|%?bl<|%xd(Ha)|%xd(Hb)|%xd(Hc)|%xd(Hd)|%xd(He)|%xd(Hf)|%xd(Hg)|%xd(Hh)|%xd(Hi)|%xd(Hj)|%xd(Hk)>>

## Clock
%V(273,0,47,16,6)%Vf(000000)%Vb(C7D8D9)
%ac%?cf<%cH:%cM|%cl:%cM>

## Main Panel
%Vi(-,0,22,-,-,4)%Vf(C7D8D9)%Vb(-)
%?mp<|%Vd(e)|%Vd(f)|||%Vd(g)|%Vd(h)|%Vd(i)|%Vd(j)>
